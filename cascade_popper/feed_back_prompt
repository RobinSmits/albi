### TOO_SPECIFIC ###
<feedback type="too_specific">
  <header>HYPOTHESIS TOO SPECIFIC (False Negative)</header>
  
  <context>{partial_cover_context}</context>
  
  <status>
    <coverage>{covered_pos}/{total_pos} positives ({coverage_pct}%)</coverage>
    <negatives_rejected>{rejected_neg}/{total_neg}</negatives_rejected>
    <goal>100% positive coverage, 0% negative coverage</goal>
  </status>
  
  <problem>Your hypothesis REJECTED a positive example that it MUST accept.</problem>
  
  <failed_hypothesis>
```prolog
{previous_code}
```
  </failed_hypothesis>
  
  <missed_example>{failed_positive_example}</missed_example>
  
  <evidence description="Actual facts for this example from BK">
```prolog
{example_facts}
```
  </evidence>
  
  <diagnosis>
    <instruction>Your rule has a constraint that the above facts do NOT satisfy.</instruction>
    <options>
      <option id="A">REMOVE the overly-specific constraint</option>
      <option id="B">ADD a disjunctive clause (second rule) to cover this case</option>
    </options>
  </diagnosis>
  
  <constraints>
    <rule id="C1">Use ONLY predicates from BK. No hallucination.</rule>
    <rule id="C2">ONE CLAUSE PER LINE. No line breaks inside clauses.</rule>
    <rule id="C3">No singleton variables. Use _ for unused vars.</rule>
    <rule id="C6">Output ONLY prolog code block.</rule>
  </constraints>
  
  <beam_search required="MANDATORY" enforcement="STRICT">
    <warning>YOU MUST GENERATE EXACTLY 3 CANDIDATES. FAILURE TO DO SO IS A CRITICAL ERROR.</warning>
    <instruction>Generate 3 DIFFERENT hypothesis candidates. YOU MUST use "---CANDIDATE---" separator between each.</instruction>
    <rule>If you output only 1 hypothesis without ---CANDIDATE--- separators, YOUR OUTPUT IS INVALID.</rule>
    <candidate id="1">Generalize existing rule - NO negation (\+) allowed</candidate>
    <candidate id="2">Add disjunctive clause - NO negation (\+) allowed</candidate>
    <candidate id="3">Alternative - may use negation (\+) if needed</candidate>
    <reminder>You MUST include "---CANDIDATE---" between each hypothesis!</reminder>
  </beam_search>
  
  <output_format>
```prolog
% CANDIDATE 1 (Generalize):
your_rule_v1(A) :- body(A).

---CANDIDATE---

% CANDIDATE 2 (Add clause):
your_rule_v2(A) :- different_body(A).

---CANDIDATE---

% CANDIDATE 3 (Alternative):
```
  </output_format>
</feedback>

